#version 460 core
#include "contour_area.glsl"
layout(local_size_x=1) in;
layout(std430,binding=0) buffer Results{vec4 values[];};
void rectangle(vec2 lo,vec2 hi,out vec2 p[20]){
    p[0]=lo;p[1]=vec2(hi.x,lo.y);p[2]=hi;p[3]=vec2(lo.x,hi.y);
}
void main(){
    uint test=gl_GlobalInvocationID.x;
    vec2 a[20],b[20];int na=4,nb=0;
    rectangle(vec2(-2),vec2(2),a);
    if(test==1u){rectangle(vec2(0,-2),vec2(2),a);rectangle(vec2(-2),vec2(0,2),b);nb=4;}
    if(test==2u){rectangle(vec2(0,-2),vec2(2),a);rectangle(vec2(0,-2),vec2(2),b);nb=4;}
    if(test==3u){rectangle(vec2(0,-2),vec2(2),a);rectangle(vec2(-2,0),vec2(2),b);nb=4;}
    if(test==4u)rectangle(vec2(-0.5,-2),vec2(0.5,2),a);
    if(test==5u)rectangle(vec2(0.5,-2),vec2(2),a);
    if(test==6u)rectangle(vec2(2),vec2(3),a);
    if(test==7u)rectangle(vec2(1,-2),vec2(2),a);
    if(test==8u)rectangle(vec2(-0.1),vec2(0.1),a);
    if(test==9u){
        rectangle(vec2(0,-2),vec2(2),a);rectangle(vec2(0,-2),vec2(2),b);nb=4;
        mat2 rotation=mat2(0.7071067812,0.7071067812,-0.7071067812,0.7071067812);
        for(int i=0;i<4;++i)b[i]=rotation*b[i];
    }
    if(test==10u){rectangle(vec2(-2),vec2(2),b);nb=4;}
    if(test==11u){rectangle(vec2(-0.1),vec2(0.1),a);rectangle(vec2(0.3,-0.1),vec2(0.5,0.1),b);nb=4;}
    if(test==12u){rectangle(vec2(-0.1),vec2(0.1),a);rectangle(vec2(0.3,-0.1),vec2(0.5,0.1),b);nb=4;}
    if(test==13u){rectangle(vec2(0,-2),vec2(2),a);rectangle(vec2(0.3,-0.1),vec2(0.5,0.1),b);nb=4;}
    if(test==14u){
        rectangle(vec2(0,-2),vec2(2),a);rectangle(vec2(0,-2),vec2(2),b);nb=4;
        mat2 rotation=mat2(-0.5,0.8660254038,-0.8660254038,-0.5);
        for(int i=0;i<4;++i)b[i]=rotation*b[i];
    }
    vec3 areas;contourUnionArea(a,na,b,nb,areas);
    vec2 polygons[80];int sizes[8];sizes[0]=na;sizes[1]=nb;
    for(int i=0;i<na;++i)polygons[i]=a[i];
    for(int i=0;i<nb;++i)polygons[10+i]=b[i];
    int count=2;
    if(test>=12u){
        vec2 third[20];sizes[2]=4;count=3;
        if(test==12u)rectangle(vec2(-0.5,-0.1),vec2(-0.3,0.1),third);
        if(test==13u)rectangle(vec2(0,-2),vec2(2),third);
        if(test==14u){
            rectangle(vec2(0,-2),vec2(2),third);
            mat2 rotation=mat2(-0.5,-0.8660254038,0.8660254038,-0.5);
            for(int i=0;i<4;++i)third[i]=rotation*third[i];
        }
        for(int i=0;i<4;++i)polygons[20+i]=third[i];
    }
    float total=contourManyUnion(polygons,sizes,count);
    values[test]=vec4(areas,total)/contourPi;
}
