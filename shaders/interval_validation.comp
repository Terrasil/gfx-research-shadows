#version 460 core
#define INTERVAL_WRITER 1
#include "packed_depth.glsl"
layout(local_size_x=64) in;
void main(){
    uint i=gl_GlobalInvocationID.x;
    if(i>=4096u)return;
    uint pixel=i%128u;
    uint q=1000u+(i*137u+(i/128u)*(i/128u)*31u+pixel*19u)%62000u;
    recordDepthAt(ivec3(int(pixel%16u),int(pixel/16u),0),float(q)/65535.0);
}
