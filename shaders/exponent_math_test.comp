#version 460 core
#include "exponent_math.glsl"
layout(local_size_x=1) in;
layout(std430,binding=0) buffer Results{vec4 values[];};
void main(){
    int test=int(gl_GlobalInvocationID.x),count=2;
    float ys[8]=float[8](0.0,0.25,0.5,1.0,2.0,4.0,0.000001,0.001);
    float y=ys[test%8],g[256];g[0]=0.1;g[1]=5.0;
    if(test>=8&&test<16){count=32;for(int i=0;i<count;++i)g[i]=0.7;}
    if(test>=16&&test<24){count=5;g[0]=0.01;g[1]=0.1;g[2]=0.7;g[3]=2.0;g[4]=9.0;}
    if(test>=24&&test<32){count=256;for(int i=0;i<count;++i)g[i]=exp(-18.0+24.0*float((i*137)%256)/255.0);}
    if(test==32)count=0;
    if(test==33){count=1;g[0]=0.037;y=2.0;}
    if(test==34){values[test]=vec4(distanceExponent(0,0.5,6,0,2),distanceExponent(0.5,0.5,6,0,2),distanceExponent(6,0.5,6,0,2),distanceExponent(99,0.5,6,0,2));return;}
    if(test==35){values[test]=vec4(distanceExponent(0,0.5,6,0.75,0.75),distanceExponent(2,0.5,6,0.75,0.75),distanceExponent(6,0.5,6,0.75,0.75),distanceExponent(99,0.5,6,0.75,0.75));return;}
    if(test==36){
        vec3 stats=exponentStatistics(g,count);vec4 valid=vec4(1);
        float previousPower=exp(stats.y),previousInverse=stats.x;
        for(int i=0;i<=64;++i){float exponent=float(i)/16.0;
            float a=exponentGap(g,count,stats,exponent,false),b=exponentGap(g,count,stats,exponent,true);
            if(a>previousPower+1e-5)valid.x=0;if(b>previousInverse+1e-5)valid.y=0;
            if(a<stats.z-1e-6||a>stats.x+1e-5)valid.z=0;
            if(b<stats.z-1e-6||b>stats.x+1e-5)valid.w=0;
            previousPower=a;previousInverse=b;
        }
        values[test]=valid;return;
    }
    if(test==37){count=256;y=0.5;for(int i=0;i<count;++i)g[i]=i%2==0?0.1:5.0;}
    if(test==38){count=4;y=0.5;g[0]=0.1;g[1]=0.1;g[2]=0.1;g[3]=5.0;}
    if(test==39){count=4;y=4.0;g[0]=1e-8;g[1]=1e-8;g[2]=1000;g[3]=1000;}
    vec3 stats=exponentStatistics(g,count);
    float a=exponentGap(g,count,stats,y,false),b=exponentGap(g,count,stats,y,true);
    float automatic=distanceExponent(count>0?exp(stats.y):0.0,0.5,6.0,0.0,2.0);
    for(int i=0;i<count;++i)g[i]*=7.0;
    vec3 scaled=exponentStatistics(g,count);
    float scaling=count>0?exponentGap(g,count,scaled,y,false)/max(a*7.0,1e-30):1.0;
    values[test]=vec4(a,b,automatic,scaling);
}
