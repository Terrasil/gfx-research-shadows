#version 460 core
// Bounded depth/opacity lists inspired by Selgrad et al. (2015).
// Eight fragments per hierarchy texel; the last output merges any excess.
layout(local_size_x=8,local_size_y=8) in;
layout(binding=2) uniform sampler2DArray uMaps;
layout(binding=4) uniform sampler2DArray uHierarchy;
layout(rg32f,binding=0) uniform writeonly image2DArray uOutput;
uniform int uLevel,uDepthLayers;
uniform float uMergeEpsilon;
void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,imageSize(uOutput).xy)))return;
    if(uLevel==0){
        for(int k=0;k<8;++k){
            float d=k<uDepthLayers?texelFetch(uMaps,ivec3(p,k),0).r:1.0;
            imageStore(uOutput,ivec3(p,k),vec4(d,d<1.0?1.0:0.0,0,0));
        }
        return;
    }
    vec2 fragments[32];int children[32];int count=0;
    ivec2 previousSize=textureSize(uHierarchy,uLevel-1).xy;
    for(int child=0;child<4;++child){
        ivec2 q=min(p*2+ivec2(child&1,child>>1),previousSize-1);
        for(int k=0;k<8;++k){
            vec2 f=texelFetch(uHierarchy,ivec3(q,k),uLevel-1).rg;
            if(f.y<=0.0)continue;
            int index=count++;
            while(index>0&&fragments[index-1].x>f.x){
                fragments[index]=fragments[index-1];children[index]=children[index-1];--index;
            }
            fragments[index]=f;children[index]=child;
        }
    }
    int next=0;
    for(int k=0;k<8;++k){
        vec2 value=vec2(1,0);
        if(next<count){
            float end=k==7?1e30:fragments[next].x+uMergeEpsilon;
            vec4 opacity=vec4(0);float depthSum=0.0,weight=0.0;
            while(next<count&&fragments[next].x<=end){
                vec2 f=fragments[next];int child=children[next];
                opacity[child]=1.0-(1.0-opacity[child])*(1.0-f.y);
                depthSum+=f.x*f.y;weight+=f.y;++next;
            }
            value=vec2(depthSum/max(weight,1e-12),dot(opacity,vec4(0.25)));
        }
        imageStore(uOutput,ivec3(p,k),vec4(value,0,0));
    }
}
