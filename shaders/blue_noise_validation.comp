#version 460 core
layout(local_size_x=1) in;
layout(std430,binding=0) buffer Results{vec4 values[];};
uniform int uCaseBase;
#include "pcss_sampling.glsl"
#include "blue_noise.glsl"
void main(){
    int c=int(gl_GlobalInvocationID.x)+uCaseBase;
    vec2 world=vec2(float(c%16-8)*0.125+0.03125,float(c/16-4)*0.25+0.0625);
    const uint seeds[4]=uint[4](0u,19u,35u,2147483647u);
    const int counts[7]=int[7](1,3,4,32,48,96,256);
    vec2 angles=worldBlueNoiseAngles(world,seeds[c%4]);
    vec2 periodic=worldBlueNoiseAngles(world+uBlueNoiseTile*vec2(2,-3),seeds[c%4]);
    int count=counts[c%7],index=c%count;
    values[c*2]=vec4(angles,periodic);
    values[c*2+1]=vec4(diskSample(index,count,angles.x,3,0u),diskSample(index,count,angles.y,3,0u));
}
