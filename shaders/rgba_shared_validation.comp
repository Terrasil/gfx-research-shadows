#version 460 core
layout(local_size_x=8,local_size_y=8) in;
#include "rgba_depth_read.glsl"
layout(std430,binding=6) buffer Result{vec4 values[];};
uniform mat4 uViews[4];
uniform vec3 uAxisX[4],uAxisY[4],uAxisZ[4],uSun;
uniform vec4 uBiasScale,uExtents,uDepthRanges;
uniform int uMapResolution,uSmoothing,uMixMode,uCascades;
uniform float uDepthBias,uCenterWeight,uCascadeBlend,uAngularMix,uTanAngle;
#include "warp.glsl"
#include "rgba_mixing.glsl"
#include "rgba_visibility.glsl"
#include "rgba_pcf.glsl"
#include "rgba_shared.glsl"
void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(p,ivec2(16))))return;
    vec3 world=vec3((vec2(p)+vec2(0.37,0.63))/4.0-2.0,0.1+float((p.x+p.y)%3)*0.04);
    vec3 n=normalize(vec3(float(p.x%3-1)*0.15,float(p.y%3-1)*0.2,1));
    if(p.y==14)n=normalize(vec3(1,-2.0/3.0,0));
    if(p.y==15)n=vec3(0,1,0);
    vec4 center=vec4(1),margins=vec4(-1),valid=vec4(0);vec2 gradients[4];
    for(int i=0;i<4;++i){
        vec4 clip=uViews[i]*vec4(world,1);vec3 light=clip.xyz/clip.w;light.z=light.z*0.5+0.5;
        margins[i]=1.0-max(abs(light.x),abs(light.y));
        valid[i]=margins[i]>0.0&&light.z>=0.0&&light.z<=1.0?1.0:0.0;
        float den=dot(n,uAxisZ[i]);
        gradients[i]=abs(den)>1e-7?-0.5*vec2(dot(n,uAxisX[i]),dot(n,uAxisY[i]))/den:vec2(0);
        center[i]=visibility(light,i,gradients[i]);
    }
    vec4 radii=vec4(0.03,0.06,0.09,0.12)*float((p.x+p.y)%3+1);
    float radius=rgbaSharedRadiusWorld(radii,valid);
    float base=rgbaCombinedVisibility(center,margins,valid,uCascades!=0,uCascadeBlend,uAngularMix,uCenterWeight,uMixMode);
    float result=rgbaSharedFilter(world,n,gradients,radius,base);
    float planeError=abs(dot(n,rgbaSharedOffset(vec2(radius,0),n)))+abs(dot(n,rgbaSharedOffset(vec2(0,radius),n)));
    values[p.y*16+p.x]=vec4(result,radius,planeError,base);
}
