#version 460 core
layout(local_size_x=8,local_size_y=8) in;
layout(binding=3) uniform sampler2DArray uInput;
#if BASIS_METHOD == 0
layout(rg32f,binding=0) writeonly uniform image2DArray uOutput;
#elif BASIS_METHOD == 1
layout(rgba32f,binding=0) writeonly uniform image2DArray uOutput;
#else
layout(r32f,binding=0) writeonly uniform image2DArray uOutput;
#endif
uniform int uSize,uLayers,uRadius,uHorizontal;
void main(){
    ivec3 p=ivec3(gl_GlobalInvocationID);if(any(greaterThanEqual(p,ivec3(uSize,uSize,uLayers))))return;
    float sigma=max(float(uRadius)*0.5,0.5),weight=0.0;vec4 sum=vec4(0);
    for(int i=-uRadius;i<=uRadius;++i){
        ivec2 q=clamp(p.xy+(uHorizontal!=0?ivec2(i,0):ivec2(0,i)),ivec2(0),ivec2(uSize-1));
        float w=exp(-0.5*float(i*i)/(sigma*sigma));sum+=w*texelFetch(uInput,ivec3(q,p.z),0);weight+=w;
    }
    imageStore(uOutput,p,sum/weight);
}
