#version 460 core
layout(local_size_x=8,local_size_y=8) in;
layout(binding=2) uniform sampler2DArray uMaps;
#if BASIS_METHOD == 0
layout(rg32f,binding=0) writeonly uniform image2DArray uOutput;
#elif BASIS_METHOD == 1
layout(rgba32f,binding=0) writeonly uniform image2DArray uOutput;
#else
layout(r32f,binding=0) writeonly uniform image2DArray uOutput;
#endif
uniform int uSize,uLayers;
uniform float uExponent;
void main(){
    ivec3 p=ivec3(gl_GlobalInvocationID);if(any(greaterThanEqual(p,ivec3(uSize,uSize,uLayers))))return;
    float d=texelFetch(uMaps,ivec3(p.xy,0),0).r;vec4 value=vec4(0);
#if BASIS_METHOD == 0
    value.xy=vec2(d,d*d);
#elif BASIS_METHOD == 1
    float q=0.05+0.9*d;
    float a=3.14159265358979323846*float(4*p.z+1)*q;
    float b=3.14159265358979323846*float(4*p.z+3)*q;
    value=vec4(cos(a),sin(a),cos(b),sin(b));
#else
    value.x=exp(uExponent*(d-1.0));
#endif
    imageStore(uOutput,p,value);
}
