#version 460 core
#include "contact_math.glsl"
layout(local_size_x=1) in;
layout(std430,binding=0) buffer Results{vec4 values[];};
void main(){
    uint test=gl_GlobalInvocationID.x;
    float g[256];vec4 result=vec4(0);
    g[0]=0.1;g[1]=5.0;
    if(test==0u)result=vec4(2.55,geometricGap(log(g[0])+log(g[1]),2),quantileGap(g,2,0.25),quantileGap(g,2,0));
    if(test==1u){for(int i=0;i<256;++i)g[i]=0.7;result=vec4(geometricGap(256.0*log(0.7),256),quantileGap(g,256,0.25),quantileGap(g,256,0),quantileGap(g,256,1));}
    if(test==2u)result=vec4(geometricGap(0,0),quantileGap(g,0,0),quantileGap(g,0,1),0);
    if(test==3u){g[0]=1e-8;result=vec4(geometricGap(log(g[0]),1)*1e8,quantileGap(g,1,0.25)*1e8,preferredGap(1e-8,1e-8,1)*1e8,1);}
    if(test==4u){g[0]=4;g[1]=1;g[2]=5;g[3]=2;g[4]=3;result=vec4(quantileGap(g,5,0),quantileGap(g,5,1),quantileGap(g,5,0.25),quantileGap(g,5,0.5));}
    if(test==5u){for(int i=0;i<256;++i)g[i]=float(256-i)/100.0;result=vec4(quantileGap(g,256,0.25),quantileGap(g,256,0.5),quantileGap(g,256,1),quantileGap(g,256,0));}
    if(test==6u){for(int i=0;i<256;++i)g[i]=i%2==0?0.1:5.0;result=vec4(quantileGap(g,256,0.25),quantileGap(g,256,0.5),quantileGap(g,256,0.75),quantileGap(g,256,1));}
    if(test==7u)result=vec4(quantileGap(g,2,-1),quantileGap(g,2,2),preferredGap(2.55,0.1,-1),preferredGap(2.55,0.1,2));
    if(test==8u)result=vec4(contactCurve(0),contactCurve(0.5),contactCurve(1),contactCurve(0.2));
    if(test==9u){
        float monotonic=1.0,symmetric=1.0;
        for(int i=1;i<=256;++i){float v=float(i)/256.0;
            if(contactCurve(v)<contactCurve(v-1.0/256.0))monotonic=0;
            if(abs(contactCurve(v)+contactCurve(1.0-v)-1.0)>1e-6)symmetric=0;
        }
        result=vec4(contactCurve(0.8),contactCurve(0.2)+contactCurve(0.8),monotonic,symmetric);
    }
    if(test==10u)result=vec4(chsWeight(1,0),chsWeight(1,1),chsWeight(1,0.5),chsWeight(0,0.4));
    if(test==11u)result=vec4(contactStrength(0,2,1),contactStrength(2,2,1),contactStrength(1,2,1),contactStrength(9,2,1));
    if(test==12u)result=vec4(preferredGap(2.55,sqrt(0.5),0),preferredGap(2.55,sqrt(0.5),1),preferredGap(2.55,sqrt(0.5),0.5),preferredGap(2.55,7,1));
    if(test==13u){
        float monotonic=1.0,positive=1.0;
        for(int i=0;i<=64;++i)for(int j=0;j<=64;++j){float w=chsWeight(float(i)/64.0,float(j)/64.0);
            if(w<=0.0||w>1.000001)positive=0;
            if(j>0&&w<chsWeight(float(i)/64.0,float(j-1)/64.0)-1e-6)monotonic=0;
        }
        result=vec4(monotonic,positive,contactStrength(0,2,0),contactStrength(1,2,0.5));
    }
    if(test==14u){g[0]=7;result=vec4(quantileGap(g,1,0),quantileGap(g,1,0.25),quantileGap(g,1,1),geometricGap(log(7.0),1));}
    if(test==15u){for(int i=0;i<256;++i)g[i]=float((i*137)%256+1)/100.0;result=vec4(quantileGap(g,256,0.25),quantileGap(g,256,0.5),quantileGap(g,256,0.75),quantileGap(g,256,0.99));}
    values[test]=result;
}
