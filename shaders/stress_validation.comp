#version 460 core
#include "boxes.glsl"
layout(local_size_x=1) in;
layout(std430,binding=0) buffer Result {float result[8];};
uniform vec3 uOrigin,uDirection;
uniform int uTestIndex;
void main(){
    vec4 lo,hi;sceneBox(uTestIndex,lo,hi);
    result[0]=blocked(uOrigin,uDirection)?1.0:0.0;
    result[1]=lo.x;result[2]=lo.y;result[3]=lo.z;
    result[4]=hi.x;result[5]=hi.y;result[6]=hi.z;result[7]=lo.w;
}
